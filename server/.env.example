# Required — used for generating document embeddings
OPENAI_API_KEY=sk-...

DATABASE_URL=postgresql://bonfire:bonfire@localhost:5432/bonfire

# Public base URL of this server — drives JWT issuer/audience and OAuth metadata.
# Local dev: https://localhost (if using Caddy) or http://localhost:3000
# Production: https://bonfire.example.com
BETTER_AUTH_URL=https://bonfire.example.com

# Required for production — any long random string (e.g. openssl rand -hex 32)
BETTER_AUTH_SECRET=

# Optional — enables cross-encoder reranking for improved search quality
# Get a free key at https://cohere.com
COHERE_API_KEY=

# Optional — S3/Lightsail artifact storage (original uploaded files)
# Leave AWS_BUCKET unset to disable artifact storage in local dev.
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ARTIFACT_URL_TTL_SECONDS=3600
