{
	"name": "@bonfire/server",
	"version": "0.0.0",
	"description": "An MCP server to consolidate team knowledge.",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"build": "bun build ./src/index.ts --target=bun --outdir=dist",
		"start": "bun ./dist/index.js",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"test": "bun test tests/",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"author": "Sean Spradlin",
	"license": "MIT",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.90.0",
		"@better-auth/cli": "^1.4.21",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"better-auth": "^1.6.5",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.12",
		"openai": "^6.34.0",
		"pg": "^8.20.0",
		"resend": "^6.12.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@types/bun": "^1.3.12",
		"bun-types": "^1.3.12",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.2"
	}
}
