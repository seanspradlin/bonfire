# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string. The default points at the Docker container in
# compose.yaml (bonfire/bonfire @ localhost:5432).
DATABASE_URL="postgresql://bonfire:bonfire@localhost:5432/bonfire"

# Public base URL of the app. Drives the Better Auth baseURL, the JWT
# issuer/audience, and the OAuth discovery metadata used by MCP clients.
# Local dev: http://localhost:5173   Production: https://bonfire.example.com
ORIGIN="http://localhost:5173"

# Better Auth signing secret. Use 32+ high-entropy chars in production
# (e.g. `openssl rand -hex 32`). https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Used for generating document embeddings (text-embedding-3-small, 1536 dims).
OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# Legacy alias for ORIGIN — only used as a fallback if ORIGIN is unset.
# BETTER_AUTH_URL=""

# Enables PDF / image upload parsing via Anthropic vision.
ANTHROPIC_API_KEY=""

# Enables cross-encoder reranking for improved search quality. https://cohere.com
COHERE_API_KEY=""

# Email provider for invitations and password resets. Without it, emails are
# skipped silently in dev. https://resend.com
RESEND_API_KEY=""

# Sender address for outgoing emails — must be a verified Resend domain.
# Defaults to "Bonfire <noreply@example.com>" if unset.
EMAIL_FROM=""

# ── S3 / Lightsail artifact storage (original uploaded files) ────────────────
# Leave AWS_BUCKET unset to disable artifact storage entirely.
AWS_BUCKET=""
AWS_REGION="us-east-1"
# Only needed when credentials aren't already available via the default AWS
# chain (~/.aws/credentials, instance role, etc.).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Pre-signed artifact URL TTL in seconds (default: 3600).
ARTIFACT_URL_TTL_SECONDS="3600"

# ── Initial admin seed (non-production only) ─────────────────────────────────
# Seeding runs only when SEED_ADMIN_PASSWORD is set, and never in production.
# Identity fields default to admin@example.com / Admin / admin if unset.
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_USERNAME=""
