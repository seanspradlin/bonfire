# Root .env for the Docker stack (docker compose up).
# Copy to .env and fill in OPENAI_API_KEY — everything else has a working
# container default. For host-based `bun run dev`, use server/.env.example instead.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Used for generating document embeddings (text-embedding-3-small, 1536 dims).
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Defaults — override only if you need to. Sensible values are baked into
# docker-compose.yml; uncomment here to change them.
# ---------------------------------------------------------------------------
# Public URL of the stack (the Caddy entry point). Change if you remap the port.
# BETTER_AUTH_URL=http://localhost:8080
# CLIENT_URL=http://localhost:8080

# Long random string for production — e.g. `openssl rand -hex 32`.
# BETTER_AUTH_SECRET=

# The initial admin is seeded on first boot using these (non-production only).
# SEED_ADMIN_PASSWORD=changeme123
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_NAME=Admin

# ---------------------------------------------------------------------------
# Optional integrations — leave blank to disable.
# ---------------------------------------------------------------------------
# Image analysis (the add_image MCP tool and image uploads) — https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Transactional email (invitations, password reset) — https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=

# Cross-encoder reranking for better search quality — https://cohere.com
# COHERE_API_KEY=

# S3/Lightsail artifact storage for original uploaded files.
# AWS_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ARTIFACT_URL_TTL_SECONDS=3600
