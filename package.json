{
	"name": "bonfire",
	"version": "0.0.0",
	"description": "An MCP server to consolidate team knowledge.",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"start": "bun run src/index.ts",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit"
	},
	"author": "Sean Spradlin",
	"license": "MIT",
	"dependencies": {
		"hono": "^4.12.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@types/bun": "^1.3.12",
		"typescript": "^6.0.2"
	}
}
