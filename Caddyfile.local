localhost {
	handle_path /api/* {
		reverse_proxy localhost:3000
	}

	handle /mcp {
		reverse_proxy localhost:3000 {
			flush_interval -1
		}
	}

	handle /auth/* {
		reverse_proxy localhost:3000
	}

	handle /.well-known/* {
		reverse_proxy localhost:3000
	}

	handle {
		reverse_proxy localhost:5173
	}
}
